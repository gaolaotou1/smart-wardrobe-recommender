# Frontend
VITE_API_BASE_URL=http://localhost:8088
VITE_AGENT_API_BASE_URL=http://localhost:8090

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=8088
FLASK_DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=fashion_system
DB_CHARSET=utf8mb4
AGENT_DB_READ_USER=
AGENT_DB_READ_PASSWORD=
OUTFIT_DB_WRITE_USER=
OUTFIT_DB_WRITE_PASSWORD=

# External APIs
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_API_TOKEN=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428
AGENT_TRUSTED_IMAGE_HOSTS=ark-project.tos-cn-beijing.volces.com,.imgdb.cn
ARK_TEXT_MODEL=doubao-seed-2-0-lite-260428
ARK_THINKING_ENABLED=false
SUPERBED_UPLOAD_URL=https://api.superbed.cn/upload
SUPERBED_TOKEN=
IMAGE_STORAGE_MODE=local

# Agent text model
TEXT_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
FAST_MODEL=deepseek-v4-flash
AGENT_FALLBACK_MODEL=deepseek-v4-pro
AGENT_FALLBACK_ENABLED=false
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_STRICT_TOOL_MODE=false

# Agent runtime
JWT_SECRET=replace_with_a_long_random_secret
JWT_TTL_HOURS=8
AGENT_CHECKPOINT_PATH=./data/langgraph_checkpoints.sqlite3
AGENT_UPLOAD_DIR=./data/agent_uploads
AGENT_LOG_PATH=./logs/agent.jsonl
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_CALLS=8
AGENT_RUN_TIMEOUT_SECONDS=90
MEMORY_GATE_INTERVAL_TURNS=10
CHAT_V2_ENABLED=true
RECOMMENDATION_V2_ENABLED=true
LONG_TERM_MEMORY_ENABLED=true
OUTFIT_MUTATIONS_ENABLED=true
IMAGE_ANALYSIS_ENABLED=true
WEATHER_ENABLED=true
SEMANTIC_RECALL_ENABLED=false
ADVANCED_READONLY_SQL_ENABLED=false

# Model
CLOTHES_MODEL_PATH=models/final_model_20250328_212820.pth
